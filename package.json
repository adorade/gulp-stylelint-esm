{
  "name": "gulp-stylelint-esm",
  "version": "3.0.0",
  "description": "Gulp plugin for stylelint with ES module support.",
  "author": {
    "name": "Adorade",
    "email": "office.adorade@gmail.com",
    "url": "https://adorade.ro"
  },
  "homepage": "https://github.com/adorade/gulp-stylelint-esm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adorade/gulp-stylelint-esm.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.mjs",
    "types/*.d.mts"
  ],
  "types": "types",
  "keywords": [
    "gulpplugin",
    "gulpfriendly",
    "stylelint",
    "postcss",
    "css",
    "scss",
    "esm"
  ],
  "scripts": {
    "lint": "eslint {src,test}/**/*.{mjs,js}",
    "lint:fix": "eslint {src,test}/**/*.{mjs,js} --fix",
    "jest:bin": "node --experimental-vm-modules --no-warnings $(yarn bin jest) -i",
    "jest:coverage": "yarn jest:bin --coverage",
    "test": "yarn lint && yarn jest:bin",
    "prepublishOnly": "yarn test"
  },
  "peerDependencies": {
    "stylelint": "16"
  },
  "dependencies": {
    "@adorade/plugin-error": "2.0.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "ansi-colors": "4.1.3",
    "fancy-log": "2.0.0",
    "text-table": "0.2.0",
    "write-file-atomic": "6.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "babel-jest": "30.4.1",
    "eslint": "9.39.5",
    "eslint-config-stylelint": "25.0.1",
    "eslint-plugin-jest": "29.16.0",
    "gulp": "5.0.1",
    "gulp-clean-css": "4.3.0",
    "gulp-concat": "2.6.1",
    "jest": "30.4.2",
    "sinon": "21.1.2",
    "stylelint": "16.26.1",
    "typescript": "5.9.3",
    "vinyl": "3.0.1"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "license": "MIT"
}
